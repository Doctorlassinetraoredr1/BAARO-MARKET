# --- Navigateur (Vite) : clé PUBLIQUE uniquement ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur (Vercel Functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=baaro-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.paypal.com
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_CHECKOUT_BASE_URL=

PAYMENT_SUCCESS_URL=https://your-domain.com/#/order-confirm
PAYMENT_CANCEL_URL=https://your-domain.com/#/cart
PAYMENT_RETURN_URL=https://your-domain.com/#/orders

# Emails (Resend) — optionnel en dev (dry-run dans les logs)
RESEND_API_KEY=
EMAIL_FROM=BAARO-MARKET <noreply@your-domain.com>

# Cron expiration commandes pending (minutes)
ORDER_PENDING_TTL_MINUTES=60
CRON_SECRET=change-me-long-random

# Rate limit distribué (optionnel, recommandé en prod)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# false = autoriser la mise en vente sans Stripe Connect (ex. vendeurs au Mali : fonds détenus par la plateforme, payouts 'pending')
REQUIRE_STRIPE_CONNECT=true

# Livraison : calcul côté serveur (lib/shipping.js), pas de clé externe requise.

# Transporteurs réels (Shippo) — optionnel. Sans clé → grilles internes.
# Compte: https://apps.goshippo.com/
SHIPPO_API_TOKEN=
# SHIPPO_API_BASE=https://api.goshippo.com

# Analyse IA des avis (optionnel). Compatible OpenAI / xAI / Groq…
# Sans clé → heuristique locale (sentiment + thèmes).
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# xAI: https://api.x.ai/v1
# AI_MODEL=gpt-4o-mini
# xAI: grok-2-latest

# International engine
# FX provider compatible with /latest?from=XXX&to=YYY (default: Frankfurter/ECB-backed)
FX_API_URL=https://api.frankfurter.app
# Optional external tax provider endpoint/key; use only after validating your jurisdictions/contracts
TAX_API_URL=
TAX_API_KEY=
